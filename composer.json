{
  "name": "sugarmill/sqlite",
  "version": "1.0.0",
  "description": "SQLite for web applications: correct pragmas, type-aware binding, immediate write transactions with retry, schema introspection and idempotent migrations. Zero dependencies.",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/sugarmill/sqlite",
  "authors": [
    {
      "name": "David Sherlock",
      "homepage": "https://arraypress.com/"
    }
  ],
  "keywords": [
    "sqlite",
    "pdo",
    "wal",
    "database",
    "migrations",
    "transactions",
    "schema"
  ],
  "require": {
    "php": ">=8.5",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^13.0"
  },
  "autoload": {
    "psr-4": {
      "SugarMill\\Sqlite\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SugarMill\\Sqlite\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "bench": "php -d opcache.enable_cli=1 -d opcache.jit=tracing -d opcache.jit_buffer_size=64M bench/run.php"
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "support": {
    "issues": "https://github.com/sugarmill/sqlite/issues",
    "source": "https://github.com/sugarmill/sqlite"
  }
}
